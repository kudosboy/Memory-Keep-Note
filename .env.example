# Copy this file to .env, then replace every placeholder with your own values.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Optional: use public DNS if a local router blocks MongoDB Atlas SRV lookups.
DNS_SERVERS=1.1.1.1,8.8.8.8
MONGODB_URI=mongodb+srv://YOUR_DATABASE_USER:YOUR_DATABASE_PASSWORD@YOUR_CLUSTER.mongodb.net/memory_keep_note?retryWrites=true&w=majority
SESSION_SECRET=replace-this-with-a-long-random-secret


# Email Configuration (Nodemailer / Mail.ee)
SMTP_HOST=mail.mail.ee
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=YOUR_SMTP_USERNAME
SMTP_PASS=YOUR_SMTP_PASSWORD
EMAIL_FROM=Memory Keep Note <support@example.com>
MAIL_FROM=Memory Keep Note <support@example.com>
MAIL_REPLY_TO=support@example.com

# Only this email address can access /admin.html. Use the email you register with.
ADMIN_EMAIL=you@example.com
# A second, private password required after the administrator signs in.
ADMIN_ACCESS_PASSWORD=replace-with-a-long-unique-admin-password
